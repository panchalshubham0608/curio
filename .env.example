# Firebase Web App Configuration (public project identifiers, protected by Firestore Security Rules & App Check).
# NEVER place private third-party API secrets (e.g., Unsplash secret, private LLM keys) in VITE_* variables.
# Leave blank to run Curio in zero-config Local Demo Mode with full finite-session discovery & fallback AI.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Enable Firebase AI Logic (Gemini) once Firebase is configured above
VITE_ENABLE_FIREBASE_AI=false
VITE_GEMINI_MODEL=gemini-flash-latest

# Optional: Enable live public open-access content discovery (Wikipedia / Wikimedia / NASA public endpoints)
VITE_ENABLE_LIVE_DISCOVERY=false

# Server / GitHub Actions ONLY (NEVER prefix with VITE_ so they are never bundled into the browser):
# GEMINI_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# REQUIRE_FIRESTORE=false
# GEMINI_MODEL=gemini-flash-latest
# FEED_BATCH_SIZE=4
# FEED_MIN_THRESHOLD=12
# FEED_FRESH_WINDOW_HOURS=24
# FEED_MAX_ITEMS=60
# PUZZLES_BATCH_SIZE=3
# PUZZLES_MIN_THRESHOLD=12
# PUZZLES_FRESH_WINDOW_HOURS=24
# PUZZLES_MAX_ITEMS=48
# FORCE_GENERATE=false
